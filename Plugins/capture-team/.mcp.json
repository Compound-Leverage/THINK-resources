{
  "mcpServers": {
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "hunter": {
      "type": "http",
      "url": "https://mcp.hunter.io/mcp",
      "headers": {
        "X-API-Key": "${HUNTER_API_KEY}"
      },
      "env_http_headers": {
        "X-API-Key": "HUNTER_API_KEY"
      }
    },
    "gdrive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive@2025.1.14"]
    }
  }
}
